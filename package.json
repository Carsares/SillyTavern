{
    "dependencies": {
        "@agnai/sentencepiece-js": "^1.1.1",
        "@agnai/web-tokenizers": "^0.1.3",
        "@anthropic-ai/claude-agent-sdk": "0.3.289",
        "@earendil-works/pi-agent-core": "1.0.2",
        "@earendil-works/pi-ai": "1.0.2",
        "@openai/codex-sdk": "0.156.1",
        "express": "^4.21.0",
        "fflate": "^0.8.2",
        "ipaddr.js": "^2.2.0",
        "node-fetch": "^3.3.2",
        "proxy-agent": "^6.5.0",
        "sillytavern-transformers": "2.14.6"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "overrides": {
        "node-fetch": {
            "whatwg-url": "^14.0.0"
        }
    },
    "name": "conversation-v1",
    "type": "module",
    "license": "AGPL-3.0",
    "version": "1.0.0",
    "scripts": {
        "init": "node src/conversation/init.js",
        "start": "node server.js",
        "debug": "node --inspect server.js",
        "lint": "npm run lint:conversation",
        "lint:fix": "npm run lint:conversation -- --fix",
        "test:conversation:unit": "node --test --test-concurrency=6 tests/conversation/modules/*/*.test.mjs tests/conversation/evaluation/*.test.mjs",
        "test:conversation:integration": "node --test --test-concurrency=6 tests/conversation/integration/*.test.mjs",
        "lint:conversation": "eslint \"src/conversation/**/*.js\" \"public/shared/conversation/**/*.js\" \"public/modern/conversation/**/*.js\" server.js"
    },
    "bin": {
        "conversation-v1": "./server.js"
    },
    "main": "server.js",
    "devDependencies": {
        "eslint": "^8.57.1",
        "eslint-plugin-jsdoc": "^48.10.0"
    },
    "description": "Standalone Conversation v1: versioned conversations, memory and three model executors",
    "files": [
        "server.js",
        "src/conversation/",
        "public/shared/conversation/",
        "public/modern/conversation/",
        "docs/conversation/",
        "README.md",
        "LICENSE",
        "SECURITY.md",
        "CONTRIBUTING.md",
        "start.sh",
        "Start.bat"
    ]
}
