# --- Git & CI ---
.git
.github
.gitignore

# --- Docker ---
/Dockerfile
/.dockerignore
/docker/docker-compose.yml
/docker/config
/docker/extensions
/docker/data
/docker/plugins
/docker/dist
/public/scripts/extensions/third-party

# --- Plugins (keep only package files) ---
/plugins/*
!/plugins/package.json
!/plugins/package-lock.json

# --- The Folders ---
/backups
/cache
/colab
/data
/dist
/node_modules
/tests

# --- Sensitive Info ---
**/.env*
**/*.pem
**/certs

# --- Documentation ---
readme*
*.md

# --- OS & System Junk ---
**/.DS_Store
*.bat
*.cmd
*.exe
start.sh

# --- Dev Config ---
.editorconfig
.eslintrc.cjs
.eslintrc*
.vscode
**/jsconfig.json
.npmignore
.gemini
replit.nix
.replit
.nomedia

# -- Logs & Temp ---
*.log
**/tmp

# --- Local config and tool output (gitignored; may hold credentials) ---
/config.yaml
/output
/test-results
**/.playwright-cli
**/.claude
**/.codex
