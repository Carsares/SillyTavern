# Only production inputs enter the build context. User data, credentials,
# local validation output and unrelated repository files stay on the host.
**
!package.json
!package-lock.json
!server.js
!src/
!src/conversation/
!src/conversation/**
!src/tokenizers/
!src/tokenizers/nerdstash.model
!src/tokenizers/nerdstash_v2.model
!src/tokenizers/llama3.json
!public/
!public/shared/
!public/shared/conversation/
!public/shared/conversation/**
!public/modern/
!public/modern/conversation/
!public/modern/conversation/**
!docker/
!docker/docker-entrypoint.sh
**/.env*
**/*.pem
**/certs
**/*.log
**/tmp

# Explicit local artifact exclusions, including nested tool state.
**/test-results
**/.playwright-cli
/output
**/.codex
**/.claude
